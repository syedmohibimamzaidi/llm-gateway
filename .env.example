GATEWAY_API_KEY=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-your-provider-key
ANTHROPIC_API_KEY=replace-with-your-provider-key
GATEWAY_MODEL_ALIASES='{"fast":{"default_provider":"openai","models":{"openai":"gpt-4.1-mini-2025-04-14","anthropic":"claude-haiku-4-5-20251001"}},"smart":{"default_provider":"anthropic","models":{"openai":"gpt-4.1-2025-04-14","anthropic":"claude-sonnet-4-6"}}}'
GATEWAY_MAX_RETRIES=2
GATEWAY_RETRY_BASE_DELAY_SECONDS=0.1
GATEWAY_REQUEST_DEADLINE_SECONDS=45
REDIS_URL=redis://localhost:6379/0
GATEWAY_RATE_LIMIT=60
GATEWAY_RATE_WINDOW_SECONDS=60
GATEWAY_CACHE_TTL_SECONDS=60
DATABASE_URL=postgresql://gateway:gateway-dev-password@localhost:5433/gateway
GATEWAY_PRICE_CONFIG_PATH=prices.live.json
